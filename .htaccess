# php -- BEGIN cPanel-generated handler (disabled locally)
# EasyApache handler from production. Laragon/Apache does not know
# application/x-httpd-ea-php56, so it served index.php as a download.
# Re-enable this block only on the cPanel server.
# <IfModule mime_module>
#   AddHandler application/x-httpd-ea-php56 .php .php5 .phtml
# </IfModule>
# php -- END cPanel-generated handler
