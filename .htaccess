Options -Indexes
RewriteEngine On

# Old codebase uses <? short tags. Needed for Laragon/PHP 7.2+ (short_open_tag is Off by default).
<IfModule php7_module>
    php_flag short_open_tag On
</IfModule>
<IfModule php_module>
    php_flag short_open_tag On
</IfModule>

